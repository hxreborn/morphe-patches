{
  "branches": [
    "main",
    {
      "name": "dev",
      "prerelease": true
    }
  ],
  "plugins": [
    [
        "@semantic-release/commit-analyzer", {
        "preset": "conventionalcommits",
        "releaseRules": [
            { "breaking": true, "release": "major" },
            { "type": "fix", "release": "patch" },
            { "type": "feat", "release": "minor" },
            { "type": "bump", "release": "patch" },
            { "type": "perf", "release": "patch" },
            { "type": "build", "scope": "Needs bump", "release": "patch" }
        ]
        }
    ],
    [
        "@semantic-release/release-notes-generator", {
        "preset": "conventionalcommits",
        "presetConfig": {
            "types": [
                { "type": "fix", "section": "Bug Fixes", "hidden": false },
                { "type": "feat", "section": "New Features", "hidden": false },
                { "type": "bump", "section": "Updated App Support", "hidden": false },
                { "type": "perf", "section": "Improvements",  "hidden": false },
                { "type": "build", "hidden": true }
            ]
        }
        }
    ],
    [
      "@MorpheApp/changelog", {
        "releaseJson": {
          "path": "patches-bundle.json",
          "downloadUrlTemplate": "https://github.com/${owner}/${repo}/releases/download/v${version}/patches-${version}.mpp",
          "signatureUrlTemplate": ""
        }
      }
    ],
    "gradle-semantic-release-plugin",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "./gradlew generatePatchesList \
          && jq '.version=\"${nextRelease.version}\"' patches-list.json > patches-list.json.tmp && mv patches-list.json.tmp patches-list.json \
          && python3 .github/scripts/generate_patches_readme.py $GITHUB_REPOSITORY $GITHUB_REF_NAME patches-list.json README.md \
          && python3 .github/scripts/generate_issue_forms.py patches-list.json"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "gradle.properties",
          "patches-bundle.json",
          "patches-list.json",
          "README.md",
          ".github/assets/icons/*.png",
          ".github/ISSUE_TEMPLATE/bug_report.yml",
          ".github/ISSUE_TEMPLATE/not_working.yml",
          ".github/ISSUE_TEMPLATE/app_update.yml"
        ],
        "message": "chore: Release v${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "patches/build/libs/patches-!(*sources*|*javadoc*).mpp?(.asc)"
          }
        ],
        "successComment": "<%\nvar repo = 'https://github.com/hxreborn/morphe-patches';\nvar version = 'v' + nextRelease.version;\nvar link = '[' + version + '](' + repo + '/releases/tag/' + version + ')';\nvar labels = (issue.labels || []).map(function (label) { return label.name; });\nvar closesIssue = new RegExp('\\\\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?)\\\\s+#' + issue.number + '\\\\b', 'i');\nvar slug = function (text) { return text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''); };\nvar scoped = commits.map(function (commit) {\n  var match = /^\\w+\\(([^)]+)\\)!?:/.exec(commit.message);\n  return match && { app: match[1].split(' - ')[0], patch: match[1].split(' - ')[1], closing: closesIssue.test(commit.message) };\n}).filter(Boolean);\nvar closing = scoped.filter(function (commit) { return commit.closing; });\nvar patchLinks = function (list) {\n  var names = [];\n  return list.filter(function (commit) {\n    var fresh = commit.patch && names.indexOf(commit.patch) < 0;\n    if (fresh) names.push(commit.patch);\n    return fresh;\n  }).map(function (commit) { return '[' + commit.patch + '](' + repo + '#' + slug(commit.app) + '-' + slug(commit.patch) + ')'; });\n};\nvar title = (issue.title || '').replace(/^\\[[^\\]]*\\]:\\s*/, '');\nvar reply = function (name) { return process.getBuiltinModule('child_process').execFileSync('python3', ['.github/actions/triage/replies.py', name], { encoding: 'utf8' }).trim(); };\nvar star = '\\n\\n' + reply('star');\nvar stable = 'been added in the stable release ' + link + '.';\nvar thanks = labels.indexOf('in pre-release') >= 0 ? ' Thanks for testing!' : '';\nvar body = 'This has ' + stable;\nif (branch.prerelease) {\n  body = 'The change has been added in the pre-release ' + link + '. Please try it and reply whether it works. This issue will close when the change reaches a stable release.';\n} else if (labels.indexOf('bug') >= 0) {\n  body = 'The fix has ' + stable + ' Thanks for reporting' + (labels.indexOf('in pre-release') >= 0 ? ' and testing it!' : ' it!');\n} else if (labels.indexOf('app-update') >= 0) {\n  var released = JSON.parse(process.getBuiltinModule('fs').readFileSync('patches-list.json', 'utf8'));\n  var targets = {};\n  released.patches.forEach(function (patch) {\n    (patch.compatiblePackages || []).forEach(function (pkg) {\n      var versions = targets[pkg.name] = targets[pkg.name] || [];\n      (pkg.targets || []).forEach(function (target) { if (target.version && versions.indexOf(target.version) < 0) versions.push(target.version); });\n    });\n  });\n  var app = Object.keys(targets).filter(function (name) { return title === name || title.indexOf(name + ' ') === 0; })\n    .sort(function (a, b) { return b.length - a.length; })[0];\n  if (app && targets[app].length) {\n    body = app + ' `' + title.slice(app.length).trim() + '` support has ' + stable + thanks;\n  }\n} else if (labels.indexOf('enhancement') >= 0) {\n  var features = patchLinks(closing);\n  body = (features.length ? features.join(' and ') + (features.length > 1 ? ' have ' : ' has ') : 'The requested feature has ')\n    + stable + thanks + star;\n}\n%><%= body %>",
        "successCommentCondition": "<% return !issue.pull_request; %>",
        "releasedLabels": false
      }
    ],
    [
      "@cleyrop-org/semantic-release-backmerge",
      {
        "backmergeBranches": [{ "from": "main", "to": "dev" }],
        "backmergeStrategy": "merge",
        "fastForwardMode": "ff",
        "clearWorkspace": true
      }
    ]
  ]
}
