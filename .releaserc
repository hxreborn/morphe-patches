{
  "branches": [
    "main"
  ],
  "plugins": [
    [
        "@semantic-release/commit-analyzer", {
        "releaseRules": [
            { "type": "fix", "release": "patch" },
            { "type": "feat", "release": "minor" },
            { "type": "bump", "release": "patch" },
            { "type": "perf", "release": "patch" },
            { "type": "build", "scope": "Needs bump", "release": "patch" }
        ]
        }
    ],
    [
        "@semantic-release/release-notes-generator", {
        "preset": "conventionalcommits",
        "presetConfig": {
            "types": [
                { "type": "fix", "section": "Bug Fixes", "hidden": false },
                { "type": "feat", "section": "New Features", "hidden": false },
                { "type": "bump", "section": "Updated App Support", "hidden": false },
                { "type": "perf", "section": "Improvements",  "hidden": false },
                { "type": "build", "hidden": true }
            ]
        }
        }
    ],
    [
      "@MorpheApp/changelog", {
        "releaseJson": {
          "path": "patches-bundle.json",
          "downloadUrlTemplate": "https://github.com/${owner}/${repo}/releases/download/v${version}/patches-${version}.mpp",
          "signatureUrlTemplate": ""
        }
      }
    ],
    "gradle-semantic-release-plugin",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "./gradlew generatePatchesList \
          && jq '.version=\"${nextRelease.version}\"' patches-list.json > patches-list.json.tmp && mv patches-list.json.tmp patches-list.json \
          && python3 .github/scripts/generate_patches_readme.py $GITHUB_REPOSITORY $GITHUB_REF_NAME patches-list.json README.md \
          && python3 .github/scripts/generate_issue_forms.py patches-list.json"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "gradle.properties",
          "patches-bundle.json",
          "patches-list.json",
          "README.md",
          ".github/assets/icons/*.png",
          ".github/ISSUE_TEMPLATE/bug_report.yml",
          ".github/ISSUE_TEMPLATE/not_working.yml"
        ],
        "message": "chore: Release v${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "patches/build/libs/patches-!(*sources*|*javadoc*).mpp?(.asc)"
          }
        ],
        "successComment": "<%\nvar repo = 'https://github.com/hxreborn/morphe-patches';\nvar version = 'v' + nextRelease.version;\nvar link = '[' + version + '](' + repo + '/releases/tag/' + version + ')';\nvar labels = (issue.labels || []).map(function (label) { return label.name; });\nvar closesIssue = new RegExp('\\\\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?)\\\\s+#' + issue.number + '\\\\b', 'i');\nvar slug = function (text) { return text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''); };\nvar scoped = commits.map(function (commit) {\n  var match = /^\\w+\\(([^)]+)\\)!?:/.exec(commit.message);\n  return match && { app: match[1].split(' - ')[0], patch: match[1].split(' - ')[1], closing: closesIssue.test(commit.message) };\n}).filter(Boolean);\nvar closing = scoped.filter(function (commit) { return commit.closing; });\nvar patchLinks = function (list) {\n  var names = [];\n  return list.filter(function (commit) {\n    var fresh = commit.patch && names.indexOf(commit.patch) < 0;\n    if (fresh) names.push(commit.patch);\n    return fresh;\n  }).map(function (commit) { return '[' + commit.patch + '](' + repo + '#' + slug(commit.app) + '-' + slug(commit.patch) + ')'; });\n};\nvar title = (issue.title || '').replace(/^\\[[^\\]]*\\]:\\s*/, '');\nvar body = 'included in ' + link;\nif (issue.pull_request) {\n} else if (labels.indexOf('bug') >= 0) {\n  body = 'this should be fixed in ' + link + '. update the bundle in Morphe Manager and repatch. feel free to reopen if it still happens';\n} else if (labels.indexOf('app-update') >= 0) {\n  body = title + ' is now supported in ' + link;\n} else if (labels.indexOf('app request') >= 0) {\n  var app = closing.length ? closing[0].app : title;\n  var patches = patchLinks(scoped.filter(function (commit) { return commit.app === app; }));\n  if (patches.length) body = 'the following ' + app + ' patches are included in ' + link + ':\\n\\n- ' + patches.join('\\n- ');\n} else if (labels.indexOf('enhancement') >= 0) {\n  var features = patchLinks(closing);\n  body = features.length\n    ? features.join(' and ') + (features.length > 1 ? ' have' : ' has') + ' been added in ' + link\n    : 'this has been added in ' + link;\n}\n%><%= body %>",
        "releasedLabels": false
      }
    ]
  ]
}
